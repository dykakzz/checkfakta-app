# CUSTOM_GEMINI_API_KEY: Optional custom Gemini API key (Priority 1).
# If set in Settings > Secrets via "Add Secret", the server uses this key first instead of the default GEMINI_API_KEY.
CUSTOM_GEMINI_API_KEY=""

# GEMINI_API_KEY: Default Gemini AI API key (Fallback if CUSTOM_GEMINI_API_KEY is empty).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on Cloud Run.
# Used for Telegram Bot Webhook registration and self-referential links.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional token from @BotFather for direct Cloud Run 24/7 Telegram Bot webhook mode.
TELEGRAM_BOT_TOKEN=""
